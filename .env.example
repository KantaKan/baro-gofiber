# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/baro
DATABASE_NAME=baro

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-this

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Environment
ENVIRONMENT=development

# Supabase Storage (S3-compatible) — Stamp Board / Poster images
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_S3_SECRET_KEY=your-s3-secret-key
SUPABASE_S3_BUCKET=stamps
SUPABASE_STORAGE_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public
